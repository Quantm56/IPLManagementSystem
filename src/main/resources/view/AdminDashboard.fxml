<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.AdminDashboardController"
      alignment="CENTER"
      spacing="16"
      style="-fx-background-color: linear-gradient(to bottom, #0b0b0b, #161616);">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Admin Dashboard"
           style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>

    <!-- 🔥 FIXED METHOD NAMES -->
    <Button text="Manage Teams"
            onAction="#openTeams"
            maxWidth="300"
            style="-fx-background-color: #00c853; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 18;"/>

    <Button text="Manage Venues"
            onAction="#openVenues"
            maxWidth="300"
            style="-fx-background-color: #03a9f4; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 18;"/>

    <Button text="Schedule Match"
            onAction="#openMatches"
            maxWidth="300"
            style="-fx-background-color: #ffca28; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 18;"/>

    <Button text="Enter Result"
            onAction="#openResults"
            maxWidth="300"
            style="-fx-background-color: #ab47bc; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 18;"/>

    <Button text="Logout"
            onAction="#logout"
            maxWidth="300"
            style="-fx-background-color: #ff1744; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 18;"/>
</VBox>