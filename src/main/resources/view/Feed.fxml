<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.FeedController"
            style="-fx-background-color: #0f0f0f;">

    <top>
        <VBox spacing="16"
              style="-fx-background-color: #111111;
                     -fx-border-color: #1f1f1f;
                     -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="18" right="20" bottom="18" left="20"/>
            </padding>

            <!-- 🔥 TITLE -->
            <Label text="IPL Hub Feed"
                   style="-fx-text-fill: white;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;"/>

            <!-- 🔥 NAV BAR -->
            <HBox spacing="10">

                <Button text="Create Post"
                        onAction="#openCreatePost"
                        style="-fx-background-color: #00c853;
                               -fx-text-fill: black;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;"/>

                <Button text="Teams"
                        onAction="#openTeams"
                        style="-fx-background-color: #222;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;"/>

                <Button text="Venues"
                        onAction="#openVenues"
                        style="-fx-background-color: #222;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;"/>

                <Button text="Matches"
                        onAction="#openMatches"
                        style="-fx-background-color: #222;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;"/>

                <Button text="Results"
                        onAction="#openResults"
                        style="-fx-background-color: #222;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;"/>

                <!-- 🔥 UPDATED BUTTON -->
                <Button text="Followed Teams"
                        onAction="#openFollowTeams"
                        style="-fx-background-color: #222;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;"/>

                <Button text="Logout"
                        onAction="#logout"
                        style="-fx-background-color: #ff1744;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;"/>

            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #0f0f0f;
                           -fx-background-color: #0f0f0f;
                           -fx-border-color: transparent;">

            <content>
                <VBox fx:id="postContainer"
                      spacing="20"
                      style="-fx-background-color: #0f0f0f;">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                </VBox>
            </content>

        </ScrollPane>
    </center>
</BorderPane>