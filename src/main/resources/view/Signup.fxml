<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.SignupController"
      alignment="CENTER"
      spacing="14"
      style="-fx-background-color: linear-gradient(to bottom, #0b0b0b, #161616);">

    <padding>
        <Insets top="35" right="40" bottom="35" left="40"/>
    </padding>

    <Label text="Create Account"
           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>

    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="300"
               style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-prompt-text-fill: #8c8c8c; -fx-background-radius: 10; -fx-padding: 10;"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="300"
               style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-prompt-text-fill: #8c8c8c; -fx-background-radius: 10; -fx-padding: 10;"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="300"
                   style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-prompt-text-fill: #8c8c8c; -fx-background-radius: 10; -fx-padding: 10;"/>

    <ComboBox fx:id="favoriteTeamBox"
              promptText="Favorite Team (optional)"
              maxWidth="300"
              style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-background-radius: 10;"/>

    <Button text="Sign Up"
            onAction="#handleSignup"
            maxWidth="300"
            style="-fx-background-color: #00c853; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>

    <Button text="Back to Login"
            onAction="#goToLogin"
            maxWidth="300"
            style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>

    <Label fx:id="statusLabel"
           wrapText="true"
           maxWidth="300"
           style="-fx-text-fill: #ff5252;"/>
</VBox>