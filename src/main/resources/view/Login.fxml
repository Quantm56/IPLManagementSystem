<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController"
      alignment="CENTER"
      spacing="16"
      style="-fx-background-color: linear-gradient(to bottom, #0b0b0b, #161616);">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="IPL Hub"
           style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;"/>

    <Label text="Login to continue"
           style="-fx-text-fill: #bdbdbd; -fx-font-size: 14px;"/>

    <TextField fx:id="usernameField"
               promptText="Username"
               maxWidth="280"
               style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-prompt-text-fill: #8c8c8c; -fx-background-radius: 10; -fx-padding: 10;"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="280"
                   style="-fx-background-color: #1f1f1f; -fx-text-fill: white; -fx-prompt-text-fill: #8c8c8c; -fx-background-radius: 10; -fx-padding: 10;"/>

    <Button text="Login"
            onAction="#handleLogin"
            maxWidth="280"
            style="-fx-background-color: #00c853; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>

    <Button text="Create Account"
            onAction="#openSignup"
            maxWidth="280"
            style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 18;"/>

    <Label fx:id="statusLabel"
           wrapText="true"
           maxWidth="280"
           style="-fx-text-fill: #ff5252; -fx-font-size: 13px;"/>
</VBox>