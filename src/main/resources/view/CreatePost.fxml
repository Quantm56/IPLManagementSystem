<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CreatePostController"
      alignment="CENTER"
      spacing="16"
      style="-fx-background-color: linear-gradient(to bottom, #0b0b0b, #161616);">

    <padding>
        <Insets top="35" right="35" bottom="35" left="35"/>
    </padding>

    <!-- TITLE -->
    <Label text="Create Post"
           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>

    <!-- TEXT AREA (FIXED) -->
    <TextArea fx:id="contentField"
              promptText="Write your post..."
              prefHeight="220"
              maxWidth="420"
              wrapText="true"
              style="
                  -fx-control-inner-background: #1f1f1f;
                  -fx-text-fill: white;
                  -fx-prompt-text-fill: #8c8c8c;
                  -fx-highlight-fill: #00c853;
                  -fx-highlight-text-fill: black;
                  -fx-background-radius: 12;
              "/>

    <!-- POST BUTTON -->
    <Button text="Post"
            onAction="#handlePost"
            maxWidth="420"
            style="
                -fx-background-color: #00c853;
                -fx-text-fill: black;
                -fx-font-weight: bold;
                -fx-background-radius: 10;
                -fx-padding: 10 18;
            "/>

    <!-- BACK BUTTON -->
    <Button text="Back to Feed"
            onAction="#goBack"
            maxWidth="420"
            style="
                -fx-background-color: #2b2b2b;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 10;
                -fx-padding: 10 18;
            "/>

    <!-- STATUS -->
    <Label fx:id="statusLabel"
           maxWidth="420"
           wrapText="true"
           style="-fx-text-fill: #ff5252;"/>

</VBox>